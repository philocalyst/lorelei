+
+/// The display timing of the cell. `GB_TIMING` = fixed (default) | unthrottled | vrr; anything else
+/// is an error, never a silent fallback to fixed.
+fn timing_from_env(hz: f64) -> fakeland::TimingConfig {
+    use fakeland::TimingConfig;
+    match std::env::var("GB_TIMING").as_deref() {
+        Err(_) | Ok("") | Ok("fixed") => TimingConfig::fixed(Hz(hz)),
+        Ok("unthrottled") => TimingConfig::unthrottled(),
+        Ok("vrr") => TimingConfig::vrr(Hz(48.0), Hz(144.0)),
+        Ok(other) => panic!("GB_TIMING={other}: expected fixed, unthrottled or vrr"),
+    }
+}
