+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn one_video_four_sources_updates_an_uncovered_tile() {
+        let mut w = media(4);
+        let u = U::default();
+        w.s.update(&u);
+        w.s.damage.clear();
+        let slots = decode(Cell::OneVideo, 1, &mut w);
+        assert_eq!(slots.len(), 1, "one-video trace did not publish an existing source");
+        turn(Cell::OneVideo, 1, &mut U::default(), &mut w, &slots);
+        let stats = w.s.update(&u);
+        assert!(w.s.damage.count() > 0);
+        assert_eq!(stats.prefix_tiles, 0, "the source must remain outside glass reach");
+    }
+}
